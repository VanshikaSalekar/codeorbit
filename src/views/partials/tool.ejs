<article id="<%= it.type %>-<%= it.id %>" class="tool"><div class="ic"><%= it.title.slice(0,2) %></div><h3><%= it.title %></h3><p><%= it.summary %></p><%- include('tags', {it}) %><br><a class="btn" href="<%= it.url || '#' %>" target="_blank" rel="noopener">Open tool</a> <%- include('like', {it}) %><%- include('share', {it}) %></article>
